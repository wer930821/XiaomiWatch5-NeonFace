<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480" clipShape="CIRCLE">
    <Metadata key="PREVIEW_TIME" value="10:08:00" />
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_GOAL" value="10000" />

    <Scene>
        <!-- AMOLED black background + subtle neon rings -->
        <PartDraw x="0" y="0" width="480" height="480">
            <Ellipse x="0" y="0" width="480" height="480">
                <Fill color="#000000" />
            </Ellipse>
            <Ellipse x="13" y="13" width="454" height="454">
                <Stroke color="#123952" width="3" />
            </Ellipse>
            <Ellipse x="20" y="20" width="440" height="440">
                <Stroke color="#087CFF" width="2" />
            </Ellipse>
            <Ellipse x="26" y="26" width="428" height="428">
                <Stroke color="#18E5F5" width="2" />
            </Ellipse>
        </PartDraw>

        <!-- Full-frame animated scenery image -->
        <PartAnimatedImage x="0" y="0" width="480" height="480">
            <AnimationController play="ON_VISIBLE"/>
            <AnimatedImage resource="night_lake_anim" format="AGIF"/>
            <Thumbnail resource="night_lake_thumb"/>
            <Variant mode="AMBIENT" target="alpha" value="0"/>
        </PartAnimatedImage>

        <!-- Dynamic neon second marker: one revolution per minute -->
        <Group name="second_orbit" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * 6" />
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw x="226" y="30" width="28" height="28">
                <Ellipse x="8" y="8" width="12" height="12">
                    <Fill color="#8BFAFF" />
                </Ellipse>
                <Ellipse x="3" y="3" width="22" height="22">
                    <Stroke color="#20E5F5" width="2" />
                </Ellipse>
            </PartDraw>

        </Group>

        <!-- Weather -->
        <ComplicationSlot
            slotId="1"
            displayName="weather_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="48"
            y="62"
            width="150"
            height="66">

            <BoundingOval x="0" y="0" width="150" height="66" />

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="150" height="66">
                    <RoundRectangle x="0" y="0" width="150" height="66" cornerRadius="28">
                        <Fill color="#071116" />
                        <Stroke color="#1A6D87" width="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="8" y="8" width="134" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#E4FCFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="EMPTY">
                <PartText x="8" y="8" width="134" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#8298A0"><![CDATA[天氣]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Variant mode="AMBIENT" target="alpha" value="0" />
        </ComplicationSlot>

        <!-- Battery -->
        <Group x="282" y="62" width="150" height="66">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw x="0" y="0" width="150" height="66">
                <RoundRectangle x="0" y="0" width="150" height="66" cornerRadius="28">
                    <Fill color="#071116" />
                    <Stroke color="#1A6D87" width="2" />
                </RoundRectangle>
            </PartDraw>

            <PartText x="0" y="8" width="150" height="50">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#E4FCFF">
                        <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
                <Launch target="BATTERY_STATUS" />
            </PartText>
        </Group>

        <!-- Main time: use the WFF native clock element -->
        <DigitalClock x="40" y="150" width="400" height="118">
            <TimeText
                x="0"
                y="0"
                width="400"
                height="118"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#F2FDFF" />
            </TimeText>
        </DigitalClock>

        <!-- Date -->
        <PartText x="95" y="268" width="290" height="42">
            <Text align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#69EAF8">
                    <Template><![CDATA[%02d/%02d  %s]]>
                        <Parameter expression="[MONTH]" />
                        <Parameter expression="[DAY]" />
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="150" y="316" width="180" height="4">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="180" height="4" cornerRadius="2">
                <Fill color="#18E5F5" />
            </RoundRectangle>
        </PartDraw>

        <!-- Lower info glass panels keep data readable over scenery -->
        <PartDraw x="0" y="0" width="480" height="480">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="34" y="332" width="190" height="90" cornerRadius="24">
                <Fill color="#66050A0F" />
                <Stroke color="#3020DCEB" width="1" />
            </RoundRectangle>
            <RoundRectangle x="256" y="332" width="190" height="90" cornerRadius="24">
                <Fill color="#66050A0F" />
                <Stroke color="#303C6B78" width="1" />
            </RoundRectangle>
        </PartDraw>

        <!-- Steps -->
        <Group x="42" y="338" width="175" height="92">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartText x="0" y="0" width="175" height="50">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#42ECEB">
                        <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText x="0" y="50" width="175" height="28">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="16" color="#8EA7B0"><![CDATA[步數]]></Font>
                </Text>
            </PartText>
        </Group>

        <!-- Heart-rate complication: use Wear OS system heart-rate provider instead of [HEART_RATE] -->
        <ComplicationSlot
            slotId="2"
            displayName="heart_rate_slot"
            supportedTypes="SHORT_TEXT SMALL_IMAGE EMPTY"
            x="263"
            y="338"
            width="175"
            height="92">

            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingOval x="0" y="0" width="175" height="92" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="175" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FF6683">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>

                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率 bpm]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage x="62" y="2" width="50" height="50">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="EMPTY">
                <PartText x="0" y="0" width="175" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#FF6683"><![CDATA[--]]></Font>
                    </Text>
                </PartText>
                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率 bpm]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Variant mode="AMBIENT" target="alpha" value="0" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
