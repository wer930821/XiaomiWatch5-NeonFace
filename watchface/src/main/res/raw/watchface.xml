<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480" clipShape="CIRCLE">
    <Metadata key="PREVIEW_TIME" value="10:08:00" />
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_GOAL" value="10000" />

    <Scene>
        <!-- AMOLED black background + subtle neon rings -->
        <PartDraw x="0" y="0" width="480" height="480">
            <Ellipse x="0" y="0" width="480" height="480">
                <Fill color="#000000" />
            </Ellipse>
            <Ellipse x="13" y="13" width="454" height="454">
                <Stroke color="#123952" width="3" />
            </Ellipse>
            <Ellipse x="20" y="20" width="440" height="440">
                <Stroke color="#087CFF" width="2" />
            </Ellipse>
            <Ellipse x="26" y="26" width="428" height="428">
                <Stroke color="#18E5F5" width="2" />
            </Ellipse>
        </PartDraw>

        <!-- Scenic layer A: night mountains, moon, stars and lake -->
        <Group name="scenery" x="0" y="0" width="480" height="480">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <!-- Moon -->
            <PartDraw x="0" y="0" width="480" height="480">
                <Ellipse x="325" y="118" width="42" height="42">
                    <Fill color="#DDFBFF" />
                </Ellipse>
                <Ellipse x="337" y="110" width="42" height="42">
                    <Fill color="#000000" />
                </Ellipse>
            </PartDraw>

            <!-- Stars -->
            <PartDraw x="0" y="0" width="480" height="480">
                <Ellipse x="90" y="132" width="4" height="4"><Fill color="#A7F7FF" /></Ellipse>
                <Ellipse x="132" y="111" width="3" height="3"><Fill color="#D7FCFF" /></Ellipse>
                <Ellipse x="186" y="135" width="4" height="4"><Fill color="#79EFFF" /></Ellipse>
                <Ellipse x="245" y="105" width="3" height="3"><Fill color="#D7FCFF" /></Ellipse>
                <Ellipse x="286" y="139" width="4" height="4"><Fill color="#79EFFF" /></Ellipse>
                <Ellipse x="392" y="148" width="3" height="3"><Fill color="#D7FCFF" /></Ellipse>
            </PartDraw>

            <!-- Distant mountain line -->
            <PartDraw x="0" y="0" width="480" height="480">
                <Line startX="54" startY="342" endX="105" endY="306"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="105" startY="306" endX="145" endY="331"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="145" startY="331" endX="205" endY="290"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="205" startY="290" endX="250" endY="326"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="250" startY="326" endX="306" endY="297"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="306" startY="297" endX="360" endY="334"><Stroke color="#0A5365" width="3" /></Line>
                <Line startX="360" startY="334" endX="426" endY="309"><Stroke color="#0A5365" width="3" /></Line>
            </PartDraw>

            <!-- Foreground mountain line -->
            <PartDraw x="0" y="0" width="480" height="480">
                <Line startX="42" startY="374" endX="92" endY="337"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="92" startY="337" endX="137" endY="365"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="137" startY="365" endX="192" endY="325"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="192" startY="325" endX="242" endY="367"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="242" startY="367" endX="302" endY="334"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="302" startY="334" endX="355" endY="372"><Stroke color="#19DCEB" width="3" /></Line>
                <Line startX="355" startY="372" endX="431" endY="342"><Stroke color="#19DCEB" width="3" /></Line>
            </PartDraw>

            <!-- Lake horizon and reflections -->
            <PartDraw x="0" y="0" width="480" height="480">
                <Line startX="78" startY="382" endX="402" endY="382"><Stroke color="#147D91" width="2" /></Line>
                <Line startX="132" startY="396" endX="348" endY="396"><Stroke color="#0C6878" width="2" /></Line>
                <Line startX="166" startY="407" endX="314" endY="407"><Stroke color="#0A4D59" width="2" /></Line>
                <Line startX="194" startY="418" endX="286" endY="418"><Stroke color="#073941" width="2" /></Line>
            </PartDraw>
        </Group>

        <!-- Dynamic neon second marker: one revolution per minute -->
        <Group name="second_orbit" x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * 6" />
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw x="226" y="30" width="28" height="28">
                <Ellipse x="8" y="8" width="12" height="12">
                    <Fill color="#8BFAFF" />
                </Ellipse>
                <Ellipse x="3" y="3" width="22" height="22">
                    <Stroke color="#20E5F5" width="2" />
                </Ellipse>
            </PartDraw>

            <PartDraw x="234" y="54" width="12" height="22">
                <RoundRectangle x="4" y="0" width="4" height="22" cornerRadius="2">
                    <Fill color="#20E5F5" />
                </RoundRectangle>
            </PartDraw>
        </Group>

        <!-- Animated step-progress arc -->
        <PartDraw x="0" y="0" width="480" height="480">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Arc centerX="240" centerY="240" width="414" height="414" startAngle="205" endAngle="205">
                <Transform target="endAngle" value="205 + min([STEP_PERCENT], 100) * 1.3">
                    <Animation duration="0.6" interpolation="EASE_IN_OUT" />
                </Transform>
                <Stroke color="#19DCEB" thickness="5" />
            </Arc>
        </PartDraw>

        <!-- Weather -->
        <ComplicationSlot
            slotId="1"
            displayName="weather_slot"
            supportedTypes="SHORT_TEXT EMPTY"
            x="48"
            y="62"
            width="150"
            height="66">

            <BoundingOval x="0" y="0" width="150" height="66" />

            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="150" height="66">
                    <RoundRectangle x="0" y="0" width="150" height="66" cornerRadius="28">
                        <Fill color="#071116" />
                        <Stroke color="#1A6D87" width="2" />
                    </RoundRectangle>
                </PartDraw>
                <PartText x="8" y="8" width="134" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="25" weight="BOLD" color="#E4FCFF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="EMPTY">
                <PartText x="8" y="8" width="134" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="20" color="#8298A0"><![CDATA[天氣]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Variant mode="AMBIENT" target="alpha" value="0" />
        </ComplicationSlot>

        <!-- Battery -->
        <Group x="282" y="62" width="150" height="66">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartDraw x="0" y="0" width="150" height="66">
                <RoundRectangle x="0" y="0" width="150" height="66" cornerRadius="28">
                    <Fill color="#071116" />
                    <Stroke color="#1A6D87" width="2" />
                </RoundRectangle>
            </PartDraw>

            <PartText x="0" y="8" width="150" height="50">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="27" weight="BOLD" color="#E4FCFF">
                        <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
                <Launch target="BATTERY_STATUS" />
            </PartText>
        </Group>

        <!-- Main time: use the WFF native clock element -->
        <DigitalClock x="40" y="150" width="400" height="118">
            <TimeText
                x="0"
                y="0"
                width="400"
                height="118"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="88" weight="BOLD" color="#F2FDFF" />
            </TimeText>
        </DigitalClock>

        <!-- Date -->
        <PartText x="95" y="268" width="290" height="42">
            <Text align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="21" weight="BOLD" color="#69EAF8">
                    <Template><![CDATA[%02d/%02d  %s]]>
                        <Parameter expression="[MONTH]" />
                        <Parameter expression="[DAY]" />
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <PartDraw x="150" y="316" width="180" height="4">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <RoundRectangle x="0" y="0" width="180" height="4" cornerRadius="2">
                <Fill color="#18E5F5" />
            </RoundRectangle>
        </PartDraw>

        <!-- Steps -->
        <Group x="42" y="338" width="175" height="92">
            <Variant mode="AMBIENT" target="alpha" value="0" />

            <PartText x="0" y="0" width="175" height="50">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#42ECEB">
                        <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>

            <PartText x="0" y="50" width="175" height="28">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="16" color="#8EA7B0"><![CDATA[步數]]></Font>
                </Text>
            </PartText>
        </Group>

        <!-- Heart-rate complication: use Wear OS system heart-rate provider instead of [HEART_RATE] -->
        <ComplicationSlot
            slotId="2"
            displayName="heart_rate_slot"
            supportedTypes="SHORT_TEXT SMALL_IMAGE EMPTY"
            x="263"
            y="338"
            width="175"
            height="92">

            <DefaultProviderPolicy
                defaultSystemProvider="HEART_RATE"
                defaultSystemProviderType="SHORT_TEXT" />

            <BoundingOval x="0" y="0" width="175" height="92" />

            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="175" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="34" weight="BOLD" color="#FF6683">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>

                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率 bpm]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="SMALL_IMAGE">
                <PartImage x="62" y="2" width="50" height="50">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Complication type="EMPTY">
                <PartText x="0" y="0" width="175" height="50">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#FF6683"><![CDATA[--]]></Font>
                    </Text>
                </PartText>
                <PartText x="0" y="50" width="175" height="28">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#B99AA4"><![CDATA[心率 bpm]]></Font>
                    </Text>
                </PartText>
            </Complication>

            <Variant mode="AMBIENT" target="alpha" value="0" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
