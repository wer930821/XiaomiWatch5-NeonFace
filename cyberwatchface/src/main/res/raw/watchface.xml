<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="480" height="480" clipShape="CIRCLE">
    <Metadata key="PREVIEW_TIME" value="10:08:00" />
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="STEP_GOAL" value="10000" />

    <Scene>
        <!-- Xiaomi Watch 5 does not render this AGIF layer reliably. Use the
             matching static source image for the visible face instead. -->
        <PartImage x="0" y="0" width="480" height="480">
            <Image resource="cyber_concept_bg"/>
            <Variant mode="AMBIENT" target="alpha" value="0"/>
        </PartImage>

        <!-- Animated active-mode layer; the static image above stays as a safe fallback. -->
        <PartAnimatedImage x="0" y="0" width="480" height="480">
            <AnimationController play="ON_VISIBLE"/>
            <AnimatedImage resource="cyber_exact_anim" format="AGIF"/>
            <Thumbnail resource="cyber_exact_thumb"/>
            <Variant mode="AMBIENT" target="alpha" value="0"/>
        </PartAnimatedImage>

        <!-- AMOLED fallback / AOD -->
        <PartDraw x="0" y="0" width="480" height="480" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Ellipse x="0" y="0" width="480" height="480"><Fill color="#000000" /></Ellipse>
            <Ellipse x="18" y="18" width="444" height="444"><Stroke color="#4A1675" width="2" /></Ellipse>
        </PartDraw>

        <!-- Outer neon seconds dot -->
        <Group x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * 6" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="226" y="18" width="28" height="28">
                <Ellipse x="7" y="7" width="14" height="14"><Fill color="#FF4DF2" /></Ellipse>
                <Ellipse x="2" y="2" width="24" height="24"><Stroke color="#00E9FF" width="2" /></Ellipse>
            </PartDraw>
        </Group>

        <!-- Counter-rotating cyan satellite: native WFF motion, no AGIF required. -->
        <Group x="0" y="0" width="480" height="480" pivotX="0.5" pivotY="0.5">
            <Transform target="angle" value="[SECOND] * -6" />
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="231" y="44" width="18" height="18">
                <Ellipse x="5" y="5" width="8" height="8"><Fill color="#68F4FF" /></Ellipse>
                <Ellipse x="1" y="1" width="16" height="16"><Stroke color="#FF55DC" width="1" /></Ellipse>
            </PartDraw>
        </Group>

        <!-- Native weather is WFF v2 data, not a complication provider. -->
        <Group x="54" y="64" width="166" height="72">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="166" height="72">
                <Rectangle x="7" y="4" width="152" height="64"><Fill color="#B4090D20" /></Rectangle>
                <Line startX="12" startY="0" endX="142" endY="0"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="0" startY="12" endX="0" endY="60"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="0" startY="60" endX="12" endY="72"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="12" startY="72" endX="142" endY="72"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="142" startY="0" endX="166" endY="18"><Stroke color="#A34CFF" width="2" /></Line>
                <Line startX="166" startY="18" endX="166" endY="54"><Stroke color="#A34CFF" width="2" /></Line>
                <Line startX="166" startY="54" endX="148" endY="72"><Stroke color="#A34CFF" width="2" /></Line>
            </PartDraw>
            <Condition>
                <Expressions><Expression name="weather_available">[WEATHER.IS_AVAILABLE]</Expression></Expressions>
                <Compare expression="weather_available">
                    <Group x="0" y="0" width="166" height="72">
                        <PartText x="8" y="7" width="150" height="34">
                            <Text align="CENTER" verticalAlign="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="29" weight="BOLD" color="#DDFBFF">
                                    <Template><![CDATA[%d°]]><Parameter expression="[WEATHER.TEMPERATURE]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                        <PartText x="8" y="39" width="150" height="25">
                            <Text align="CENTER" verticalAlign="CENTER">
                                <Font family="SYNC_TO_DEVICE" size="16" color="#6DEAFF">
                                    <Template><![CDATA[%s]]><Parameter expression="[WEATHER.CONDITION_NAME]" /></Template>
                                </Font>
                            </Text>
                        </PartText>
                    </Group>
                </Compare>
                <Default>
                    <PartText x="8" y="8" width="150" height="56">
                        <Text align="CENTER" verticalAlign="CENTER">
                            <Font family="SYNC_TO_DEVICE" size="18" color="#6DEAFF"><![CDATA[天氣讀取中]]></Font>
                        </Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>

        <!-- Top-right battery -->
        <Group x="260" y="64" width="166" height="72">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartDraw x="0" y="0" width="166" height="72">
                <Rectangle x="7" y="4" width="152" height="64"><Fill color="#B4090D20" /></Rectangle>
                <Line startX="12" startY="0" endX="142" endY="0"><Stroke color="#FF39D9" width="2" /></Line>
                <Line startX="0" startY="18" endX="24" endY="0"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="0" startY="18" endX="0" endY="54"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="0" startY="54" endX="18" endY="72"><Stroke color="#00DFFF" width="2" /></Line>
                <Line startX="18" startY="72" endX="148" endY="72"><Stroke color="#FF39D9" width="2" /></Line>
                <Line startX="142" startY="0" endX="166" endY="18"><Stroke color="#FF39D9" width="2" /></Line>
                <Line startX="166" startY="18" endX="166" endY="60"><Stroke color="#FF39D9" width="2" /></Line>
                <Line startX="166" startY="60" endX="154" endY="72"><Stroke color="#FF39D9" width="2" /></Line>
            </PartDraw>
            <PartText x="0" y="8" width="166" height="56">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="28" weight="BOLD" color="#FFFFFF">
                        <Template><![CDATA[%d%%]]><Parameter expression="[BATTERY_PERCENT]" /></Template>
                    </Font>
                </Text>
            </PartText>
        </Group>

        <!-- Huge split-color time like the approved concept -->
        <DigitalClock x="56" y="142" width="144" height="112">
            <TimeText x="0" y="0" width="144" height="112" format="hh"
                hourFormat="SYNC_TO_DEVICE" align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" color="#52E8FF" />
            </TimeText>
        </DigitalClock>
        <PartText x="196" y="142" width="76" height="112">
            <Text align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="84" weight="BOLD" color="#D9F9FF"><![CDATA[:]]></Font>
            </Text>
        </PartText>
        <DigitalClock x="272" y="142" width="152" height="112">
            <TimeText x="0" y="0" width="152" height="112" format="mm"
                hourFormat="SYNC_TO_DEVICE" align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="100" weight="BOLD" color="#FF55DC" />
            </TimeText>
        </DigitalClock>

        <!-- Date -->
        <PartText x="105" y="246" width="270" height="40">
            <Text align="CENTER" verticalAlign="CENTER">
                <Font family="SYNC_TO_DEVICE" size="24" weight="BOLD" color="#E4E9FF">
                    <Template><![CDATA[%s, %02d/%02d]]>
                        <Parameter expression="[DAY_OF_WEEK_S]" />
                        <Parameter expression="[MONTH]" />
                        <Parameter expression="[DAY]" />
                    </Template>
                </Font>
            </Text>
        </PartText>

        <!-- Bottom cards -->
        <PartDraw x="0" y="0" width="480" height="480">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Rectangle x="43" y="356" width="176" height="80"><Fill color="#B4090D20" /></Rectangle>
            <Rectangle x="261" y="356" width="176" height="80"><Fill color="#B4090D20" /></Rectangle>
            <Line startX="50" startY="352" endX="202" endY="352"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="36" startY="366" endX="36" endY="424"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="36" startY="424" endX="52" endY="440"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="52" startY="440" endX="204" endY="440"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="202" startY="352" endX="226" endY="376"><Stroke color="#A34CFF" width="2" /></Line>
            <Line startX="226" startY="376" endX="226" endY="426"><Stroke color="#A34CFF" width="2" /></Line>
            <Line startX="226" startY="426" endX="212" endY="440"><Stroke color="#A34CFF" width="2" /></Line>

            <Line startX="268" startY="352" endX="420" endY="352"><Stroke color="#FF39D9" width="2" /></Line>
            <Line startX="254" startY="366" endX="254" endY="424"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="254" startY="366" endX="268" endY="352"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="254" startY="424" endX="270" endY="440"><Stroke color="#00DFFF" width="2" /></Line>
            <Line startX="270" startY="440" endX="422" endY="440"><Stroke color="#FF39D9" width="2" /></Line>
            <Line startX="420" startY="352" endX="444" endY="376"><Stroke color="#FF39D9" width="2" /></Line>
            <Line startX="444" startY="376" endX="444" endY="426"><Stroke color="#FF39D9" width="2" /></Line>
            <Line startX="444" startY="426" endX="430" endY="440"><Stroke color="#FF39D9" width="2" /></Line>
        </PartDraw>

        <Group x="42" y="356" width="178" height="78">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <PartText x="0" y="0" width="178" height="48">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="32" weight="BOLD" color="#52E8FF">
                        <Template><![CDATA[%d]]><Parameter expression="[STEP_COUNT]" /></Template>
                    </Font>
                </Text>
            </PartText>
            <PartText x="0" y="47" width="178" height="24">
                <Text align="CENTER" verticalAlign="CENTER">
                    <Font family="SYNC_TO_DEVICE" size="14" color="#9EDFE9"><![CDATA[步數 STEPS]]></Font>
                </Text>
            </PartText>
        </Group>

        <ComplicationSlot slotId="12" displayName="heart_rate_slot"
            supportedTypes="SHORT_TEXT SMALL_IMAGE EMPTY" x="260" y="356" width="178" height="78">
            <DefaultProviderPolicy defaultSystemProvider="HEART_RATE" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="178" height="78" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="178" height="48">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="32" weight="BOLD" color="#FF58DF">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="47" width="178" height="24">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#E7A6DC"><![CDATA[心率 BPM]]></Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="64" y="2" width="50" height="44"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="EMPTY">
                <PartText x="0" y="0" width="178" height="48">
                    <Text align="CENTER" verticalAlign="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#FF58DF"><![CDATA[--]]></Font>
                    </Text>
                </PartText>
            </Complication>
            <Variant mode="AMBIENT" target="alpha" value="0" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
